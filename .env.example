# Never put the real key in GitHub.
OPENAI_API_KEY=

# Used automatically when a public Vercel Blob store is connected.
BLOB_READ_WRITE_TOKEN=

# Pages 2-4 together. Maximum supported by the included cron schedule is 30.
DAILY_LESSON_IMAGE_LIMIT=30

# Required by Vercel Cron and already used by the Page 1 builder.
CRON_SECRET=
